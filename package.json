{
  "name": "freedom-code",
  "displayName": "Freedom Code",
  "description": "一个强大的 VS Code 扩展，提供多语言文件格式化、代码片段自动补全和模板文件快速创建功能",
  "icon": "./logo.jpg",
  "main": "./extension.js",
  "version": "0.2.4",
  "publisher": "Kiraalla",
  "homepage": "https://github.com/Kiraalla/freedom-code",
  "bugs": {
    "url": "https://github.com/Kiraalla/freedom-code/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "keywords": [
    "wxml",
    "小程序",
    "mini",
    "wechat",
    "weapp",
    "js",
    "jq",
    "vue",
    "vant",
    "layui"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pug",
        "aliases": [
          "Pug",
          "Jade",
          "pug"
        ],
        "extensions": [
          ".pug",
          ".jade"
        ],
        "configuration": "./languages/pug-language-configuration.json"
      },
      {
        "id": "wxml",
        "extensions": [
          ".wxml"
        ],
        "aliases": [
          "WXML",
          "wxml"
        ]
      },
      {
        "id": "wxss",
        "extensions": [
          ".wxss"
        ],
        "aliases": [
          "WXSS",
          "wxss"
        ],
        "configuration": "./languages/wxss-language-configuration.json"
      },
      {
        "id": "vue",
        "aliases": [
          "Vue",
          "vue"
        ],
        "extensions": [
          ".vue"
        ],
        "configuration": "./languages/vue-language-configuration.json"
      },
      {
        "id": "vue-html",
        "aliases": [
          "Vue-html"
        ],
        "configuration": "./languages/vue-html-language-configuration.json"
      },
      {
        "id": "vue-postcss",
        "aliases": [
          "Vue-PostCSS",
          "Vue-POSTCSS",
          "vue-postcss"
        ],
        "configuration": "./languages/vue-postcss-language-configuration.json"
      },
      {
        "id": "vue-css",
        "aliases": [
          "Vue-CSS",
          "Vue-Css",
          "vue-css"
        ],
        "configuration": "./languages/vue-postcss-language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "extension.compilePug",
        "title": "编译 Pug 为 HTML"
      },
      {
        "command": "extension.pickCssFormatStyle",
        "title": "重选 CSS 格式化模式（标准 / 紧凑）"
      },
      {
        "command": "extension.syncEditorStyleSettings",
        "title": "把格式化风格写入编辑器设置"
      },
      {
        "command": "extension.createMiniappModule",
        "title": "创建小程序组件"
      },
      {
        "command": "extension.createMiniappPage",
        "title": "创建小程序页面"
      },
      {
        "command": "extension.createdHtml",
        "title": "创建HTML文件模板"
      },
      {
        "command": "extension.createdVue2",
        "title": "创建Vue2文件模板"
      },
      {
        "command": "extension.createdVue3",
        "title": "创建Vue3文件模板"
      },
      {
        "command": "extension.createdVuex",
        "title": "创建Vuex文件模板"
      },
      {
        "command": "extension.createdPinia",
        "title": "创建Pinia文件模板"
      },
      {
        "command": "extension.createdService",
        "title": "创建Service文件模板"
      },
      {
        "command": "extension.createdTools",
        "title": "创建Tools文件模板"
      },
      {
        "command": "extension.formatUnified",
        "title": "格式化文档 (统一格式化器)"
      },
      {
        "when": "editorLangId == vue",
        "command": "extension.formatvue",
        "title": "Vue 格式化"
      },
      {
        "when": "editorLangId == wxml",
        "command": "extension.formatwxml",
        "title": "Wxml 格式化"
      },
      {
        "when": "editorLangId == wxss",
        "command": "extension.formatwxss",
        "title": "Wxss 格式化"
      },
      {
        "when": "editorLangId == scss",
        "command": "extension.formatscss",
        "title": "SCSS 格式化"
      },
      {
        "when": "editorLangId == less",
        "command": "extension.formatless",
        "title": "Less 格式化"
      },
      {
        "when": "editorLangId == css",
        "command": "extension.formatcss",
        "title": "CSS 格式化"
      },
      {
        "when": "editorLangId == html",
        "command": "extension.formathtml",
        "title": "HTML 格式化"
      },
      {
        "when": "editorLangId == javascript",
        "command": "extension.formatjavascript",
        "title": "JavaScript 格式化"
      },
      {
        "when": "editorLangId == typescript",
        "command": "extension.formattypescript",
        "title": "TypeScript 格式化"
      },
      {
        "command": "extension.compileScss",
        "title": "编译 SCSS/SASS 为 CSS"
      }
    ],
    "submenus": [
      {
        "id": "freedomCode.templates",
        "label": "Freedom Code - 创建模板"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "freedomCode.templates",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "freedomCode.templates": [
        {
          "command": "extension.createdVue2",
          "group": "1_vue@1"
        },
        {
          "command": "extension.createdVue3",
          "group": "1_vue@2"
        },
        {
          "command": "extension.createdHtml",
          "group": "1_vue@3"
        },
        {
          "command": "extension.createdPinia",
          "group": "2_state@1"
        },
        {
          "command": "extension.createdVuex",
          "group": "2_state@2"
        },
        {
          "command": "extension.createdService",
          "group": "2_state@3"
        },
        {
          "command": "extension.createMiniappPage",
          "group": "3_weapp@1"
        },
        {
          "command": "extension.createMiniappModule",
          "group": "3_weapp@2"
        },
        {
          "command": "extension.createdTools",
          "group": "4_tools@1"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.formatUnified",
          "when": "editorLangId == wxml || editorLangId == vue || editorLangId == wxss || editorLangId == scss || editorLangId == less || editorLangId == css || editorLangId == html || editorLangId == javascript || editorLangId == typescript"
        }
      ]
    },
    "grammars": [
      {
        "language": "pug",
        "scopeName": "text.pug",
        "path": "./syntaxes/pug/pug.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "source.js": "javascript",
          "source.ts": "typescript"
        }
      },
      {
        "language": "vue",
        "scopeName": "source.vue",
        "path": "./syntaxes/vue/vue-generated.json",
        "embeddedLanguages": {
          "text.html.basic": "html",
          "text.html.vue-html": "vue-html",
          "text.jade.slm": "slm",
          "text.pug": "pug",
          "text.haml": "haml",
          "text.slim": "slim",
          "text.html.liquid": "liquid",
          "source.css": "css",
          "source.css.scss": [
            "scss",
            "css"
          ],
          "source.css.less": [
            "less",
            "css"
          ],
          "source.css.postcss": [
            "vue-postcss",
            "css"
          ],
          "source.js": [
            "javascript"
          ],
          "source.ts": [
            "typescript",
            "javascript"
          ],
          "source.coffee": "coffeescript",
          "text.html.markdown": "md",
          "source.yaml": "yaml",
          "source.json": "json",
          "source.php": "php",
          "source.graphql": "graphql"
        }
      },
      {
        "language": "vue-postcss",
        "scopeName": "source.css.postcss",
        "path": "./syntaxes/vue/vue-postcss.json"
      },
      {
        "language": "vue-html",
        "scopeName": "text.html.vue-html",
        "path": "./syntaxes/vue/vue-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript"
        }
      },
      {
        "path": "./syntaxes/pug/directives.tmLanguage.json",
        "scopeName": "vue.pug.directives",
        "injectTo": [
          "source.vue"
        ]
      },
      {
        "path": "./syntaxes/pug/interpolations.tmLanguage.json",
        "scopeName": "vue.pug.interpolations",
        "injectTo": [
          "source.vue"
        ]
      },
      {
        "language": "wxml",
        "scopeName": "text.wxml.basic",
        "path": "./syntaxes/wxml/wxml.tmLanguage.json"
      },
      {
        "language": "wxml",
        "scopeName": "text.wxml.derivative",
        "path": "./syntaxes/wxml/wxml-derivative.tmLanguage.json"
      },
      {
        "language": "wxss",
        "scopeName": "source.css.wxss",
        "path": "./syntaxes/wxss/wxss.tmLanguage.json"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.formatDocument",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && !editorReadonly && (editorLangId == wxml || editorLangId == vue || editorLangId == wxss || editorLangId == scss || editorLangId == less || editorLangId == css || editorLangId == html || editorLangId == javascript || editorLangId == typescript)"
      }
    ],
    "configuration": {
      "title": "Freedom Code",
      "properties": {
        "freedomCode.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "是否启用调试模式（显示详细日志）"
        },
        "freedomCode.prettierOptions": {
          "type": "object",
          "description": "📝 Prettier 统一配置（适用于所有支持的文件类型）",
          "markdownDescription": "**统一格式化配置**\n\n适用于所有文件类型的基础配置。\n\n> 💡 **提示**: 点击「在 settings.json 中编辑」可查看详细配置示例\n\n> 📝 **单独配置不同文件类型**:\n> 使用 `overrides` 配置不同文件类型的格式化规则:\n> ```json\n> {\n>   \"overrides\": [\n>     {\n>       \"files\": [\"*.scss\"],\n>       \"options\": { \"tabWidth\": 4, \"singleQuote\": true }\n>     },\n>     {\n>       \"files\": [\"*.wxml\", \"*.wxss\"],\n>       \"options\": { \"tabWidth\": 2, \"printWidth\": 120 }\n>     }\n>   ]\n> }\n> ```",
          "default": {
            "printWidth": 80,
            "tabWidth": 2,
            "useTabs": false,
            "semi": false,
            "singleQuote": false,
            "singleAttributePerLine": false,
            "bracketSameLine": true,
            "htmlWhitespaceSensitivity": "ignore"
          }
        },
        "freedomCode.mustacheSpacing": {
          "type": "string",
          "enum": [
            "space",
            "preserve",
            "nospace"
          ],
          "default": "space",
          "description": "Mustache 表达式的空格风格（{{ value }} 或 {{value}}）"
        },
        "freedomCode.cssFormatStyle": {
          "type": "string",
          "enum": [
            "normal",
            "compact"
          ],
          "default": "normal",
          "markdownDescription": "CSS / WXSS 的排版风格：normal = 每条属性一行（Prettier 默认）；compact = 一条规则一行、属性用空格分隔。也可用命令「重选 CSS 格式化模式」切换。"
        },
        "freedomCode.formatOnSave": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "改用 VS Code 自带的 editor.formatOnSave：本扩展只提供格式化器，不再自带保存钩子。",
          "description": "💾 保存时自动格式化（已废弃，请改用 editor.formatOnSave）"
        },
        "freedomCode.scssAutoCompile": {
          "type": "boolean",
          "default": false,
          "description": "💾 保存 SCSS 文件时自动编译"
        },
        "freedomCode.pugAutoCompile": {
          "type": "boolean",
          "default": false,
          "description": "保存 .pug 文件时自动编译为 HTML"
        },
        "freedomCode.pugPretty": {
          "type": "boolean",
          "default": true,
          "description": "用 Prettier 美化编译出的 HTML（尊重项目的格式化配置）"
        },
        "freedomCode.pugIgnoreUnderscore": {
          "type": "boolean",
          "default": true,
          "description": "跳过 _ 开头的部分文件（partial）"
        },
        "freedomCode.pugOutputPath": {
          "type": "string",
          "default": "",
          "description": "HTML 的输出路径（留空则输出到同目录）"
        },
        "freedomCode.pugOutputPathFormat": {
          "type": "string",
          "enum": [
            "same",
            "custom",
            "relative"
          ],
          "default": "same",
          "description": "输出路径策略：same 同目录 / custom 自定义目录 / relative 工作区相对目录"
        },
        "freedomCode.pugBasedir": {
          "type": "string",
          "default": "",
          "description": "pug include/extends 的基准目录（绝对路径或相对工作区，留空用文件所在目录）"
        },
        "freedomCode.scssIncludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "SCSS 编译时额外的 @use / @import 查找路径"
        },
        "freedomCode.scssIgnoreUnderscoreFiles": {
          "type": "boolean",
          "default": true,
          "description": "跳过 _ 开头的部分文件（partial）"
        },
        "freedomCode.scssOutputCompact": {
          "type": "boolean",
          "default": true,
          "description": "输出紧凑格式（一条规则一行）"
        },
        "freedomCode.scssRemoveCharset": {
          "type": "boolean",
          "default": true,
          "description": "移除输出中的 @charset 声明"
        },
        "freedomCode.scssOutputPathFormat": {
          "type": "string",
          "enum": [
            "same",
            "custom",
            "relative"
          ],
          "default": "same",
          "description": "输出路径策略：same 同目录 / custom 自定义目录 / relative 工作区相对目录"
        },
        "freedomCode.scss-compact-autoCompile": {
          "type": "boolean",
          "description": "💾 保存 SCSS 文件时自动编译",
          "deprecationMessage": "已改名：请使用 scssAutoCompile。旧键仍会读取。"
        },
        "freedomCode.scssPreserveComments": {
          "type": "boolean",
          "default": false,
          "description": "在输出的 CSS 中保留注释"
        },
        "freedomCode.scssOutputExtension": {
          "type": "string",
          "default": ".css",
          "description": "编译输出文件扩展名（如 .css、.wxss、.acss）"
        },
        "freedomCode.scssOutputPath": {
          "type": "string",
          "default": "",
          "description": "CSS 文件的输出路径（留空则输出到同目录）"
        },
        "freedomCode.wxmlActiveDisable": {
          "type": "boolean",
          "default": false,
          "description": "🎨 禁用 WXML 标签高亮"
        },
        "freedomCode.wxml-activeDisable": {
          "type": "boolean",
          "description": "🎨 禁用 WXML 标签高亮",
          "deprecationMessage": "已改名：请使用 wxmlActiveDisable。旧键仍会读取。"
        },
        "freedomCode.wxmlActiveColor": {
          "type": "object",
          "description": "🎨 WXML 标签高亮颜色",
          "default": {
            "color": "#00ffff"
          }
        },
        "freedomCode.wxml-activeColor": {
          "type": "object",
          "description": "🎨 WXML 标签高亮颜色",
          "deprecationMessage": "已改名：请使用 wxmlActiveColor。旧键仍会读取。"
        },
        "freedomCode.wxmlTagNoActiveArr": {
          "type": "array",
          "description": "🎨 不高亮的 WXML 标签列表",
          "markdownDescription": "**不高亮的标签列表**\n\n这些标签不会被高亮显示。\n\n> 💡 **提示**: 在 settings.json 中配置此选项",
          "default": [
            "view",
            "scroll-view",
            "swiper",
            "movable-view",
            "cover-view",
            "text",
            "icon",
            "progress",
            "rich-text",
            "button",
            "checkbox",
            "form",
            "input",
            "label",
            "picker",
            "picker-view",
            "radio",
            "slider",
            "switch",
            "textarea",
            "navigator",
            "functional-page-navigator",
            "image",
            "audio",
            "video",
            "map",
            "canvas",
            "ad",
            "official-account",
            "open-data",
            "web-vie"
          ]
        },
        "freedomCode.wxml-tagNoActiveArr": {
          "type": "array",
          "description": "🎨 不高亮的 WXML 标签列表",
          "deprecationMessage": "已改名：请使用 wxmlTagNoActiveArr。旧键仍会读取。"
        },
        "freedomCode.vueSupportedLanguages": {
          "type": "array",
          "description": "🔍 Vue 定义跳转支持的语言",
          "default": [
            "vue",
            "javascript",
            "typescript"
          ],
          "items": {
            "type": "string"
          }
        },
        "freedomCode.vue-supportedLanguages": {
          "type": "array",
          "description": "🔍 Vue 定义跳转支持的语言",
          "deprecationMessage": "已改名：请使用 vueSupportedLanguages。旧键仍会读取。",
          "items": {
            "type": "string"
          }
        },
        "freedomCode.vueTargetFileExtensions": {
          "type": "array",
          "description": "🔍 Vue 定义跳转支持的文件扩展名",
          "default": [
            ".vue",
            ".js",
            ".ts"
          ],
          "items": {
            "type": "string"
          }
        },
        "freedomCode.vue-targetFileExtensions": {
          "type": "array",
          "description": "🔍 Vue 定义跳转支持的文件扩展名",
          "deprecationMessage": "已改名：请使用 vueTargetFileExtensions。旧键仍会读取。",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/pages/**/*.json"
        ],
        "url": "./schemas/page.json"
      },
      {
        "fileMatch": [
          "**/components/**/*.json"
        ],
        "url": "./schemas/component.json"
      },
      {
        "fileMatch": [
          "app.json"
        ],
        "url": "./schemas/app.json"
      }
    ],
    "snippets": [
      {
        "language": "css",
        "path": "./snippets/basic/css.json"
      },
      {
        "language": "scss",
        "path": "./snippets/basic/css.json"
      },
      {
        "language": "less",
        "path": "./snippets/basic/css.json"
      },
      {
        "language": "wxss",
        "path": "./snippets/basic/css.json"
      },
      {
        "language": "html",
        "path": "./snippets/basic/html.json"
      },
      {
        "language": "vue-html",
        "path": "./snippets/basic/html.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/basic/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/basic/javascript.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/basic/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/basic/javascript.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/basic/jq.json"
      },
      {
        "language": "pug",
        "path": "./snippets/basic/pug.json"
      },
      {
        "language": "html",
        "path": "./snippets/layui/layui-html.json"
      },
      {
        "language": "vue-html",
        "path": "./snippets/layui/layui-html.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/layui/layui-jq.json"
      },
      {
        "language": "html",
        "path": "./snippets/vant/vant-html.json"
      },
      {
        "language": "vue-html",
        "path": "./snippets/vant/vant-html.json"
      },
      {
        "language": "json",
        "path": "./snippets/vant/vant-json.json"
      },
      {
        "language": "vue",
        "path": "./snippets/vant/vant-vue.json"
      },
      {
        "language": "wxml",
        "path": "./snippets/vant/vant-wxml.json"
      },
      {
        "language": "vue",
        "path": "./snippets/vue/vue-html.json"
      },
      {
        "language": "vue",
        "path": "./snippets/vue/vue-js.json"
      },
      {
        "language": "wxml",
        "path": "./snippets/weapp/miniprogram-wxml.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/weapp/miniprogram-js.json"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.88.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "htmlparser2": "^9.1.0",
    "prettier": "^3.3.2",
    "pug": "^3.0.4",
    "recast": "^0.23.9",
    "sass": "^1.72.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiraalla/freedom-code.git"
  }
}
